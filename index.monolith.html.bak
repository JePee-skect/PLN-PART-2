<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Visitor Management System – PLN</title>
<link rel="icon" type="image/png" href="img/pln-logo.png">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* =============================================================
   TEMA & VARIABEL
   ============================================================= */
:root {
  --card:  #ffffff;
  --text:  #1e293b;
  --muted: #475569;
  --input: #ffffff;
  --line:  #d1d5db;
  --th:    #fff;
  --side:  #17435a;
  --bg:    #f3f6f9;
  --acc:   #1b6378;

  box-sizing: border-box;
  padding-top:    env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

/* Dark mode otomatis */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme=light]) {
    --bg:    #11191f;
    --card:  #1f2a30;
    --text:  #eef2f3;
    --muted: #b5c0c5;
    --input: #17212626;
    --line:  #3b4a52;
  }
}

/* Dark mode manual */
:root[data-theme=dark] {
  --bg:    #11191f;
  --card:  #1f2a30;
  --text:  #eef2f3;
  --muted: #b5c0c5;
  --input: #17212626;
  --line:  #3b4a52;
}

html { scroll-padding-top: env(safe-area-inset-top, 0px); }
*    { box-sizing: border-box; }
.hide { display: none !important; }

/* =============================================================
   LAYOUT
   ============================================================= */
body {
  margin: 0;
  display: flex;
  min-height: 100vh;
  font-family: Poppins, system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
}

aside {
  width: 250px;
  height: 100vh;
  position: sticky;
  top: 0;
  flex: none;
  display: flex;
  flex-direction: column;
  background: var(--side);
  color: #fff;
}

main {
  flex: 1;
  min-width: 0;
  padding: 28px 40px;
}

.card {
  max-width: 1200px;
  margin: 0 auto;
  padding: 36px 44px;
  border-radius: 12px;
  background: var(--card);
  border: 1px solid var(--line);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
}

h1 { font-size: 23px; margin: 0 0 24px; }
h2 { font-size: 20px; margin: 26px 0 12px; }

/* =============================================================
   SIDEBAR
   ============================================================= */
.brand {
  display: flex;
  gap: 14px;
  align-items: center;
  padding: 22px 20px;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.3;
}

.brand-logo-img {
  width: 44px;
  height: auto;
  max-height: 58px;
  display: block;
  flex: none;
  object-fit: contain;
  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.25));
}

nav a {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 14px 22px;
  color: #fff;
  font-size: 14px;
  text-decoration: none;
  opacity: .9;
}

nav a.on { background: rgba(255, 255, 255, .12); }

.me {
  width: 100%;
  margin-top: auto;
  padding: 16px 20px;
  display: flex;
  gap: 12px;
  align-items: center;
  border: 0;
  background: none;
  color: #fff;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.av {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #e8eef0;
  color: var(--side);
  font-weight: 600;
}

/* =============================================================
   FORM & INPUT
   ============================================================= */
label {
  display: block;
  margin: 18px 0 8px;
  color: var(--muted);
  font-size: 15px;
}

input[type=text],
input[type=date],
select {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--input);
  color: var(--text);
  font: inherit;
  transition: border-color 0.2s, box-shadow 0.2s;
}

input[type=text]:focus,
input[type=date]:focus,
select:focus {
  border-color: var(--acc);
  outline: none;
  box-shadow: 0 0 0 3px rgba(27, 99, 120, 0.15);
}

.bad {
  border-color: #e5483b !important;
}

.err {
  margin-top: 6px;
  color: #e5483b;
  font-size: 13px;
}

.err:empty {
  display: none;
}

.err.hint {
  color: var(--muted);
}

.btn {
  padding: 12px 28px;
  border: 0;
  border-radius: 8px;
  background: var(--acc);
  color: #fff;
  font: inherit;
  font-weight: 500;
  cursor: pointer;
  transition: opacity 0.2s;
}

.btn:hover {
  opacity: 0.9;
}

.btn.sm {
  padding: 8px 14px;
  font-size: 13px;
}

.btn.ghost {
  background: none;
  border: 2px solid var(--acc);
  color: var(--acc);
}

.photo {
  text-align: center;
}

.ph {
  display: block;
  width: 168px;
  height: 233px;
  margin: 0 auto 14px;
  object-fit: cover;
  background: #bdbdbd;
}

/* =============================================================
   CHECKBOX APD (ALAT PELINDUNG DIRI)
   ============================================================= */
.apd {
  display: flex;
  gap: 28px;
  flex-wrap: wrap;
  font-weight: 600;
  color: var(--muted);
}

.apd label {
  margin: 0;
}

.chk {
  position: relative;
  display: block;
  cursor: pointer;
}

.chk input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  opacity: 0;
  cursor: pointer;
}

.chk span {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 11px 18px;
  border: 2px solid var(--line);
  border-radius: 10px;
  font-weight: 600;
  color: var(--muted);
  user-select: none;
  transition: 0.15s;
}

.chk span::before {
  content: "";
  flex: none;
  width: 22px;
  height: 22px;
  border: 2px solid var(--muted);
  border-radius: 6px;
  text-align: center;
  font-size: 16px;
  line-height: 18px;
}

.chk input:checked + span {
  background: var(--acc);
  border-color: var(--acc);
  color: #fff;
}

.chk input:checked + span::before {
  content: "✓";
  background: #fff;
  border-color: #fff;
  color: var(--acc);
}

.chk input:focus-visible + span {
  outline: 3px solid #ffe600;
}

.chk.none input:checked + span {
  background: #c0392b;
  border-color: #c0392b;
}

.chk.none input:checked + span::before {
  color: #c0392b;
}

/* =============================================================
   SAFETY AND SECURITY INDUCTION (PLN PUSHARLIS)
   ============================================================= */
.induction-container {
  margin-top: 36px;
  padding-top: 24px;
  border-top: 1px solid var(--line);
}

.induction-header-text {
  text-align: center;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 14px;
  line-height: 1.5;
}

.induction-poster-wrapper {
  max-width: 680px;
  margin: 0 auto;
  border: 2px solid #1a202c;
  border-radius: 6px;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  position: relative;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.induction-poster-wrapper:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.16);
}

.induction-poster-img {
  width: 100%;
  height: auto;
  display: block;
}

.induction-zoom-hint {
  position: absolute;
  bottom: 8px;
  right: 8px;
  background: rgba(15, 23, 42, 0.75);
  color: #fff;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 500;
  backdrop-filter: blur(4px);
  pointer-events: none;
  opacity: 0.85;
  transition: opacity 0.2s;
}

.induction-poster-wrapper:hover .induction-zoom-hint {
  opacity: 1;
}

.induction-agree-box {
  max-width: 680px;
  margin: 16px auto 0;
  padding: 14px 18px;
  background: rgba(27, 99, 120, 0.05);
  border: 1px solid rgba(27, 99, 120, 0.22);
  border-radius: 8px;
}

.induction-agree-label {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0;
  cursor: pointer;
  user-select: none;
}

.induction-agree-label input[type="checkbox"] {
  width: 19px;
  height: 19px;
  cursor: pointer;
  accent-color: var(--acc);
  flex-shrink: 0;
  margin: 0;
}

.induction-agree-label span {
  font-size: 13.5px;
  font-weight: 500;
  color: var(--text);
  line-height: 1.4;
}

.btn-submit {
  min-width: 240px;
  padding: 14px 42px;
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.3px;
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(27, 99, 120, 0.3);
  transition: transform 0.15s ease, opacity 0.2s ease;
}

.btn-submit:hover {
  transform: translateY(-2px);
  opacity: 0.95;
}

/* =============================================================
   HALAMAN TERIMA KASIH
   ============================================================= */
.thanks {
  max-width: 640px;
  margin: 8vh auto 0;
  text-align: center;
}

.thanks .tick {
  width: 88px;
  height: 88px;
  margin: 0 auto 20px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--acc);
  color: #fff;
  font-size: 46px;
  animation: pop 0.5s ease-out;
}

.thanks p {
  margin: 0 0 8px;
  line-height: 1.6;
  color: var(--muted);
}

.thanks .btn {
  margin-top: 24px;
  padding: 16px 34px;
  font-size: 16px;
}

@keyframes pop {
  from {
    transform: scale(0.4);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* =============================================================
   DASHBOARD & STATISTIK
   ============================================================= */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.stat {
  padding: 26px 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--input);
  text-align: center;
  box-shadow: 0 1px 2px #0002;
}

.stat b {
  display: block;
  font-size: 34px;
  font-weight: 400;
  color: var(--acc);
}

.filters {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  align-items: flex-end;
}

.filters label {
  margin: 0 0 6px;
  font-size: 14px;
  color: var(--text);
}

.filters input {
  width: auto;
}

.filters .btn {
  margin-left: auto;
}

.tw {
  margin-top: 22px;
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

th {
  padding: 14px 12px;
  border-left: 1px solid #fff5;
  background: var(--acc);
  color: var(--th);
  text-align: left;
}

td {
  padding: 12px;
  border: 1px solid var(--line);
}

td.e {
  padding: 16px;
  text-align: center;
}

/* =============================================================
   DIALOG OVERLAY / MODAL
   ============================================================= */
#ov {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: grid;
  place-items: center;
  padding: 16px;
  background: #0009;
}

.dlg {
  width: 100%;
  max-width: 420px;
  max-height: 85vh;
  overflow: auto;
  padding: 24px;
  border-radius: 14px;
  background: var(--card);
  color: var(--text);
}

.dlg h2 {
  margin: 0 0 14px;
  font-size: 19px;
}

.dlg p {
  margin: 0;
  line-height: 1.5;
}

.dlg dl {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 6px 14px;
  margin: 0;
  font-size: 14px;
}

.dlg dt {
  color: var(--muted);
}

.dlg dd {
  margin: 0;
  font-weight: 500;
  word-break: break-word;
}

.acts {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  margin-top: 20px;
}

/* =============================================================
   ASISTEN ROBOT (WIDGET, BALON & PANEL CHAT)
   ============================================================= */
#bot {
  position: fixed;
  z-index: 40;
  right: max(18px, env(safe-area-inset-right, 0px));
  bottom: max(18px, env(safe-area-inset-bottom, 0px));
  font-size: 14px;
}

#fab {
  display: block;
  width: 130px;
  height: 190px;
  margin-left: auto;
  padding: 0;
  border: 0;
  background: none;
  cursor: grab;
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
  filter: drop-shadow(0 8px 10px #0006);
}

#bot.drag #fab {
  cursor: grabbing;
}

#bot.drag #bub {
  opacity: 0.4;
}

#panel {
  position: absolute;
  right: 0;
  bottom: 198px;
  width: 270px;
  max-width: calc(100vw - 36px);
  max-height: calc(100vh - 250px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 16px;
  background: var(--card);
  box-shadow: 0 10px 40px #0007;
}

#stage {
  position: relative;
  flex: none;
  height: 42px;
  background: linear-gradient(var(--side), var(--acc));
}

#stage span {
  position: absolute;
  left: 12px;
  top: 10px;
  color: #fff;
  font-size: 13px;
  font-weight: 500;
}

#spk {
  position: absolute;
  right: 40px;
  top: 8px;
  padding: 4px 10px;
  border: 0;
  border-radius: 20px;
  background: #fff3;
  color: #fff;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
  transition: background 0.2s;
}

#spk:hover {
  background: #fff5;
}

#vcfg {
  position: absolute;
  right: 8px;
  top: 8px;
  padding: 4px 8px;
  border: 0;
  border-radius: 20px;
  background: #fff3;
  color: #fff;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
  transition: background 0.2s;
}

#vcfg:hover {
  background: #fff5;
}

#msgs {
  flex: 1;
  height: 110px;
  min-height: 60px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  overflow: auto;
  padding: 8px 10px;
  font-size: 12.5px;
}

.m {
  max-width: 88%;
  padding: 8px 12px;
  border-radius: 12px;
  line-height: 1.4;
}

.m.b {
  align-self: flex-start;
  background: var(--input);
  border: 1px solid var(--line);
}

.m.u {
  align-self: flex-end;
  background: var(--acc);
  color: #fff;
}

#chips {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  padding: 0 12px 8px;
}

#chips button {
  padding: 4px 12px;
  border: 1px solid var(--acc);
  border-radius: 16px;
  background: none;
  color: var(--acc);
  font: inherit;
  font-size: 12px;
  cursor: pointer;
}

#cf {
  display: flex;
  gap: 6px;
  padding: 10px 12px;
  border-top: 1px solid var(--line);
}

#cf input {
  padding: 9px;
  font-size: 13px;
}

#bub {
  position: absolute;
  right: 122px;
  bottom: 62px;
  width: max-content;
  max-width: min(270px, calc(100vw - 180px));
  padding: 12px 16px;
  border: 3px solid #3bb7e6;
  border-radius: 20px;
  background: #10262e;
  color: #fff;
  font-size: 13.5px;
  font-weight: 700;
  line-height: 1.45;
  box-shadow: 0 6px 24px #0006;
  cursor: pointer;
}

#bub::after {
  content: "";
  position: absolute;
  right: -13px;
  top: 30px;
  border: 10px solid transparent;
  border-left: 12px solid #3bb7e6;
  border-right: 0;
}

/* Penyesuaian posisi balon saat robot digeser ke sisi lain */
#bot.left #bub {
  right: auto;
  left: 122px;
}

#bot.left #bub::after {
  right: auto;
  left: -13px;
  border: 10px solid transparent;
  border-right: 12px solid #3bb7e6;
  border-left: 0;
}

#bot.left #panel {
  right: auto;
  left: 0;
}

#bot.top #panel {
  bottom: auto;
  top: 198px;
  max-height: calc(100vh - 260px);
}

/* =============================================================
   RESPONSIF (TABLET & MOBILE)
   ============================================================= */
@media (max-width: 800px) {
  body {
    flex-direction: column;
  }

  aside {
    width: 100%;
    height: auto;
    position: static;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }

  .brand {
    padding: 12px 16px;
  }

  .brand-logo-img {
    width: 36px;
  }

  nav {
    display: flex;
  }

  .me {
    width: auto;
    margin-left: auto;
    padding: 8px 16px;
  }

  main {
    padding: 16px;
  }

  .card {
    padding: 18px;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .filters .btn {
    margin-left: 0;
  }
}

@media (max-width: 600px) {
  #fab {
    width: 98px;
    height: 143px;
  }

  #bub {
    right: 92px;
    bottom: 40px;
    font-size: 12.5px;
  }

  #panel {
    bottom: 152px;
    max-height: calc(100vh - 210px);
  }

  #bot.left #bub {
    left: 92px;
  }

  #bot.top #panel {
    top: 152px;
  }
}
</style>
</head>
<body>

<!-- ================= SIDEBAR ================= -->
<aside>
  <div class="brand">
    <img src="img/pln-logo.png" alt="Logo PT PLN (Persero)" class="brand-logo-img">
    <div style="line-height:1.25;">
      <div style="font-weight:700;font-size:14px;letter-spacing:0.3px;color:#fff;">PLN PUSHARLIS</div>
      <div style="font-size:11.5px;opacity:0.85;color:#e0f2fe;">Visitor Management System</div>
    </div>
  </div>

  <nav>
    <a href="#registrasi" id="nav-registrasi" class="on">☺ Registrasi Tamu</a>
    <a href="#dashboard" id="nav-dashboard" class="hide">⌂ Dashboard Admin</a>
  </nav>

  <div class="sidebar-footer" style="margin-top:auto;padding:14px;border-top:1px solid rgba(255,255,255,0.12);">
    <!-- Tombol saat mode Tamu (User) -->
    <button id="btn-open-login" style="width:100%;padding:11px 14px;border:1px solid rgba(255,255,255,0.25);border-radius:8px;background:rgba(255,255,255,0.08);color:#fff;font:inherit;font-size:13px;display:flex;align-items:center;gap:10px;cursor:pointer;transition:background 0.2s;" title="Khusus petugas PLN">
      <span style="font-size:15px;">🔐</span>
      <span style="font-weight:500;">Login Admin</span>
    </button>

    <!-- Info akun saat login sebagai Admin -->
    <div id="admin-session-box" class="hide" style="display:flex;flex-direction:column;gap:10px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <span class="av" style="width:34px;height:34px;border-radius:8px;background:#ffe600;color:#17435a;font-weight:700;display:grid;place-items:center;flex-shrink:0;">A</span>
        <div style="line-height:1.25;min-width:0;">
          <div style="font-size:13px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Petugas Admin</div>
          <div style="font-size:11px;color:rgba(255,255,255,0.7);">PLN PUSHARLIS</div>
        </div>
      </div>
      <button id="btn-logout" style="width:100%;padding:8px 12px;border:0;border-radius:6px;background:rgba(226,35,26,0.85);color:#fff;font:inherit;font-size:12px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:background 0.2s;">
        <span>🚪</span>
        <span>Keluar (Logout)</span>
      </button>
    </div>
  </div>
</aside>

<main>
  <!-- ========== DASHBOARD ========== -->
  <section class="card hide" id="v-dashboard">
    <h1 style="font-size:21px; margin-bottom:12px;">Daftar Tamu</h1>

    <div class="stats">
      <div class="stat"><b id="s1">0</b>Tamu Hari Ini</div>
      <div class="stat"><b id="s2">0</b>Check In Hari Ini</div>
      <div class="stat"><b id="s3">0</b>Check Out Hari Ini</div>
    </div>

    <h2>Data Tamu</h2>
    <div class="filters">
      <div>
        <label for="d1">Tanggal Awal Data:</label>
        <input type="date" id="d1">
      </div>
      <div>
        <label for="d2">Tanggal Akhir Data:</label>
        <input type="date" id="d2">
      </div>
      <div>
        <label for="q">Cari Nama Tamu:</label>
        <input type="text" id="q" placeholder="Ketik nama tamu...">
      </div>
      <button class="btn sm" id="xl">Export to Excel</button>
    </div>

    <div class="tw">
      <table>
        <thead>
          <tr>
            <th>No</th>
            <th>Tanggal Kunjungan</th>
            <th>Nama Tamu</th>
            <th>Nama Pegawai Tujuan</th>
            <th>Keperluan</th>
            <th>Status</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody id="tb"></tbody>
      </table>
    </div>
  </section>

  <!-- ========== REGISTRASI ========== -->
  <section class="card hide" id="v-registrasi">
    <h1>Formulir Tamu PLN PUSHARLIS UP2WVI</h1>
    <form id="f">
      <div class="photo">
        <img class="ph" id="pv" alt="Foto tamu" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 168 233'%3E%3Crect width='168' height='233' fill='%23bdbdbd'/%3E%3Ccircle cx='84' cy='70' r='34' fill='%238a8a8a'/%3E%3Cpath d='M20 170c0-45 30-60 64-60s64 15 64 60z' fill='%238a8a8a'/%3E%3Ctext x='84' y='195' font-size='22' fill='%23f2f2f2' text-anchor='middle' font-family='sans-serif'%3ENo Image%3C/text%3E%3Ctext x='84' y='220' font-size='22' fill='%23f2f2f2' text-anchor='middle' font-family='sans-serif'%3EAvailable%3C/text%3E%3C/svg%3E">
        <button type="button" class="btn" id="pb" style="padding:16px 30px">Ambil Foto</button>
        <input type="file" id="pf" accept="image/*" class="hide">
      </div>

      <label for="nama">Nama Tamu*</label>
      <input type="text" id="nama" required placeholder="Masukkan nama lengkap">

      <label for="usaha">Nama Perusahaan*</label>
      <input type="text" id="usaha" required placeholder="Instansi / perusahaan asal">

      <label for="alamat">Alamat Perusahaan Tamu*</label>
      <input type="text" id="alamat" required placeholder="Alamat lengkap perusahaan">

      <label for="pegawai">Nama Pegawai Yang Dituju*</label>
      <input type="text" id="pegawai" required placeholder="Nama pegawai PLN tujuan">

      <label id="apdl">Pemakaian APD*</label>
      <div class="apd" id="apd">
        <label class="chk">
          <input type="checkbox" value="Safety Helmet">
          <span>Safety Helmet</span>
        </label>
        <label class="chk">
          <input type="checkbox" value="Safety Shoes">
          <span>Safety Shoes</span>
        </label>
        <label class="chk">
          <input type="checkbox" value="Seragam Kerja">
          <span>Seragam Kerja</span>
        </label>
        <label class="chk">
          <input type="checkbox" id="apdall">
          <span>Pilih semua</span>
        </label>
        <label class="chk none">
          <input type="checkbox" id="apdnone">
          <span>Tidak memakai APD</span>
        </label>
      </div>

      <label for="perlu">Keperluan Kunjungan*</label>
      <input type="text" id="perlu" required placeholder="Tujuan berkunjung">

      <label for="ktp">No. KTP atau Identitas Lainnya*</label>
      <input type="text" id="ktp" required autocomplete="off" maxlength="20" placeholder="16 digit NIK KTP atau identitas lain">
      <div class="err" id="ktp-e"></div>

      <label for="kend">Kendaraan (Jenis / No.Pol)*</label>
      <input type="text" id="kend" required placeholder="Contoh: Avanza B 1234 CD">

      <label for="tag">No Name Tag Tamu*</label>
      <input type="text" id="tag" required placeholder="Nomor pada kartu tamu">

      <label for="jml">Jumlah Tamu*</label>
      <select id="jml" required></select>

      <!-- ========== SAFETY AND SECURITY INDUCTION (PLN PUSHARLIS) ========== -->
      <div class="induction-container" id="induction-container">
        <div class="induction-header-text">
          Selama Anda Berada di Area PT PLN (Persero) Pusharlis : Peraturan dan Tata Tertib Selama Anda Berada di Area PT PLN (Persero) Pusharlis :
        </div>

        <div class="induction-poster-wrapper" id="induction-poster-wrapper">
          <img src="img/safety-induction.jpg" alt="Safety and Security Induction PT PLN (Persero) Pusharlis" class="induction-poster-img" id="img-induction" title="Klik untuk memperbesar poster">
          <div class="induction-zoom-hint">🔍 Klik gambar untuk memperbesar</div>
        </div>

        <div class="induction-agree-box">
          <label class="induction-agree-label" for="agree-induction">
            <input type="checkbox" id="agree-induction" required>
            <span>Saya telah membaca dan memahami Safety and Security Induction di atas<span style="color:#e5483b">*</span></span>
          </label>
          <div class="err" id="agree-e" style="display:none;margin-top:8px;font-size:13px;color:#e5483b;font-weight:600;">
            ⚠️ Harap baca dan centang persetujuan Safety and Security Induction sebelum mengirim formulir.
          </div>
        </div>
      </div>

      <div style="margin-top:28px;text-align:center;">
        <button class="btn btn-submit" id="sub" type="button">Kirim Registrasi</button>
      </div>
    </form>
  </section>

  <!-- ========== TERIMA KASIH ========== -->
  <section class="card thanks hide" id="v-terima">
    <div class="tick">✓</div>
    <h1 id="thanks-title">Terima Kasih</h1>
    <p id="thanks-text"></p>
    <p>Silakan menuju petugas keamanan untuk mengambil name tag.</p>
    <button class="btn" id="again">Isi Formulir Lagi</button>
  </section>
</main>

<!-- Dialog konfirmasi / modal -->
<div id="ov" class="hide">
  <div class="dlg">
    <h2 id="ovt"></h2>
    <div id="ovb"></div>
    <div class="acts" id="ova"></div>
  </div>
</div>

<!-- Modal Login Admin -->
<div id="modal-login" class="hide" style="position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:16px;background:rgba(0,0,0,0.65);backdrop-filter:blur(4px);">
  <div class="card" style="width:100%;max-width:390px;padding:28px 24px;border-radius:14px;box-shadow:0 12px 40px rgba(0,0,0,0.4);animation:pop 0.3s ease-out;">
    <div style="text-align:center;margin-bottom:18px;">
      <img src="img/pln-logo.png" alt="Logo PT PLN (Persero)" style="width:48px;height:auto;margin:0 auto 12px;display:block;filter:drop-shadow(0 3px 8px rgba(0,0,0,0.18));">
      <h2 style="margin:0 0 4px;font-size:19px;font-weight:700;">Login Petugas Admin</h2>
      <p style="margin:0;font-size:12px;color:var(--muted);">Hanya untuk petugas berwenang PLN PUSHARLIS</p>
    </div>

    <form id="form-login">
      <label for="admin-user" style="margin:0 0 6px;font-size:13px;font-weight:600;">Username:</label>
      <input type="text" id="admin-user" required placeholder="Masukkan username" autocomplete="username" style="padding:10px 12px;font-size:13px;margin-bottom:12px;border-radius:8px;">

      <label for="admin-pass" style="margin:0 0 6px;font-size:13px;font-weight:600;">Password:</label>
      <div style="position:relative;margin-bottom:12px;">
        <input type="password" id="admin-pass" required placeholder="Masukkan password" autocomplete="current-password" style="padding:10px 38px 10px 12px;font-size:13px;border-radius:8px;">
        <button type="button" id="btn-toggle-pass" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);background:none;border:0;cursor:pointer;font-size:14px;color:var(--muted);" title="Lihat/Sembunyikan password">👁️</button>
      </div>

      <div id="login-err" class="err" style="margin-bottom:12px;display:none;font-size:12px;">Username atau password salah!</div>

      <div style="display:flex;gap:10px;margin-top:16px;">
        <button type="button" class="btn ghost" id="btn-cancel-login" style="flex:1;padding:10px;font-size:13px;">Batal</button>
        <button type="submit" class="btn" style="flex:1;padding:10px;font-size:13px;">Masuk</button>
      </div>

      <div style="margin-top:16px;padding-top:10px;border-top:1px solid var(--line);text-align:center;font-size:11.5px;color:var(--muted);">
        🔒 Sistem dilindungi. Akses terbatas untuk petugas PLN.
      </div>
    </form>
  </div>
</div>

<!-- Asisten robot -->
<div id="bot">
  <div id="bub" class="hide"></div>
  <div id="panel" class="hide">
    <div id="stage">
      <span>Asisten PLN</span>
      <button id="spk" title="Nyalakan / Matikan Suara">🔊 Aktif</button>
      <button id="vcfg" title="Pengaturan Suara">⚙️</button>
    </div>

    <!-- Panel Pengaturan Suara -->
    <div id="voice-settings" class="hide" style="padding:12px;background:var(--input);border-bottom:1px solid var(--line);font-size:12px;max-height:360px;overflow-y:auto;">
      <div style="font-weight:600;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;">
        <span>⚙️ Pengaturan Suara Asisten:</span>
        <button id="vclose" style="background:none;border:0;font-size:14px;cursor:pointer;color:var(--muted);">✕</button>
      </div>

      <!-- Pilihan Mode Suara -->
      <div style="display:flex;gap:6px;margin-bottom:10px;">
        <button id="tab-vbrowser" class="btn sm" style="flex:1;padding:6px;font-size:11px;">Suara Browser (Ardi)</button>
        <button id="tab-veleven" class="btn sm ghost" style="flex:1;padding:6px;font-size:11px;">🎙️ Suara Saya (ElevenLabs)</button>
      </div>

      <!-- Mode 1: Browser TTS -->
      <div id="sec-vbrowser">
        <label style="margin:0 0 4px;font-size:11px;color:var(--muted);">Pilih Suara Browser:</label>
        <select id="voice-select" style="width:100%;padding:6px;font-size:12px;margin-bottom:8px;border-radius:6px;"></select>
        
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
          <label style="margin:0;font-size:11px;color:var(--muted);white-space:nowrap;">Kecepatan:</label>
          <input type="range" id="voice-rate" min="0.8" max="1.2" step="0.05" value="1.0" style="flex:1;">
          <span id="rate-val" style="font-size:11px;min-width:28px;">1.0x</span>
        </div>
        
        <button class="btn sm" id="btn-test-voice" style="width:100%;padding:6px 10px;font-size:12px;">▶️ Tes Suara Browser</button>
        
        <div id="voice-tip" style="margin-top:8px;font-size:11px;line-height:1.4;color:var(--muted);background:rgba(27,99,120,0.08);padding:6px 8px;border-radius:6px;">
          💡 Buka di <b>Microsoft Edge</b> untuk suara <b>Microsoft Ardi (Natural)</b> yang paling jernih & alami.
        </div>
      </div>

      <!-- Mode 2: ElevenLabs Voice Cloning (Suara Sendiri) -->
      <div id="sec-veleven" class="hide">
        <div style="background:rgba(124,111,247,0.1);border:1px solid rgba(124,111,247,0.25);padding:8px;border-radius:8px;margin-bottom:8px;">
          <b style="color:var(--acc);">✨ Menggunakan Kloning Suara Anda</b>
          <p style="margin:4px 0 0;font-size:11px;color:var(--muted);line-height:1.4;">
            Asisten akan berbicara menggunakan suara tiruan AI dari rekaman suara Anda di ElevenLabs.
          </p>
        </div>

        <label style="margin:0 0 4px;font-size:11px;color:var(--muted);">ElevenLabs API Key:</label>
        <input type="password" id="el-api-key" placeholder="sk_..." style="padding:6px;font-size:12px;margin-bottom:6px;border-radius:6px;">

        <label style="margin:0 0 4px;font-size:11px;color:var(--muted);">Voice ID Anda:</label>
        <input type="text" id="el-voice-id" placeholder="Contoh: 21m00Tcm4TlvDq8ikWAM" style="padding:6px;font-size:12px;margin-bottom:8px;border-radius:6px;">

        <div style="display:flex;gap:6px;">
          <button class="btn sm" id="btn-save-eleven" style="flex:1;padding:6px 10px;font-size:12px;">💾 Simpan</button>
          <button class="btn sm ghost" id="btn-test-eleven" style="flex:1;padding:6px 10px;font-size:12px;">▶️ Tes Suara Saya</button>
        </div>
        <div id="el-status" style="margin-top:6px;font-size:11px;color:var(--muted);"></div>
      </div>

      <!-- File Rekaman Audio Pribadi -->
      <div style="margin-top:12px;padding-top:10px;border-top:1px dashed var(--line);">
        <div style="font-weight:600;margin-bottom:4px;color:var(--text);">🎵 Rekaman Suara Anda (my-voice.mp3):</div>
        <p style="margin:0 0 8px;font-size:11px;color:var(--muted);line-height:1.4;">
          File audio dari ElevenLabs telah tersimpan di <code>audio/my-voice.mp3</code>.
        </p>
        <button class="btn sm" id="btn-play-mp3" style="width:100%;padding:7px;font-size:12px;background:#27ae60;">
          ▶️ Putar File Rekaman Suara Saya
        </button>
      </div>
    </div>

    <div id="msgs"></div>
    <div id="chips"></div>
    <div id="cf">
      <input type="text" id="ci" placeholder="Tanya asisten...">
      <button class="btn sm" id="cs">Kirim</button>
    </div>
  </div>
  <button id="fab" aria-label="Buka asisten">
    <canvas id="fabc" width="156" height="156" style="width:100%;height:100%"></canvas>
  </button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* =====================================================================
   1. UTILITAS & STATE APLIKASI
   ===================================================================== */
const $  = (selector) => document.querySelector(selector);
const $$ = (selector) => [...document.querySelectorAll(selector)];

const store = {
  get(key, fallback) {
    try {
      const v = localStorage.getItem(key);
      return v ? JSON.parse(v) : fallback;
    } catch (e) {
      return fallback;
    }
  },
  set(key, val) {
    try {
      localStorage.setItem(key, JSON.stringify(val));
    } catch (e) {}
  }
};

const pad = (n) => String(n).padStart(2, '0');
const ymd = (d = new Date()) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;'
}[c]));

// Cek sesi login admin di sessionStorage agar setiap kali tamu baru membuka web, default selalu 'user'
let isAdminSession = false;
try {
  isAdminSession = (sessionStorage.getItem('vms-admin-auth') === 'true');
} catch (e) {}

let role  = isAdminSession ? 'admin' : 'user'; // DEFAULT TAMPILAN SELALU 'user' UNTUK TAMU!
let data  = store.get('vms-data', []);
let photo = '';

const ROLE_PAGES = ['dashboard', 'registrasi'];
const APD_LIST = ['Safety Helmet', 'Safety Shoes', 'Seragam Kerja'];
const PHOTO_PLACEHOLDER = $('#pv').src;

/* Kredensial Resmi Admin */
const ADMIN_CREDENTIALS = {
  user: 'admin',
  pass: 'admin123'
};

/* =====================================================================
   2. ROLE, AUTENTIKASI ADMIN & ROUTING HALAMAN
   ===================================================================== */
function setRole(newRole) {
  role = newRole;
  document.documentElement.dataset.role = newRole;

  const isAdmin = (newRole === 'admin');

  // Perbarui elemen UI Sidebar
  const btnOpenLogin    = $('#btn-open-login');
  const adminSessionBox = $('#admin-session-box');
  const navDashboard    = $('#nav-dashboard');

  if (btnOpenLogin)    btnOpenLogin.classList.toggle('hide', isAdmin);
  if (adminSessionBox) adminSessionBox.classList.toggle('hide', !isAdmin);
  if (navDashboard)    navDashboard.classList.toggle('hide', !isAdmin);

  renderChips();
  route();
}

function route() {
  let page = location.hash.slice(1);

  // Proteksi: Tamu tidak bisa langsung membuka #dashboard via URL tanpa login
  if (page === 'dashboard' && role !== 'admin') {
    location.hash = '#registrasi';
    openLoginModal('Akses ditolak. Silakan login sebagai petugas admin terlebih dahulu.');
    return;
  }

  if (role !== 'admin' || !ROLE_PAGES.includes(page)) {
    page = (role === 'admin') ? 'dashboard' : 'registrasi';
  }

  ROLE_PAGES.forEach((p) => {
    $('#v-' + p).classList.toggle('hide', p !== page);
    $('#nav-' + p).classList.toggle('on', p === page);
  });

  $('#v-terima').classList.add('hide');

  if (page === 'dashboard') {
    renderTable();
  }

  botHello(page);
}

/* Modal Login Admin */
function openLoginModal(hintMsg = '') {
  $('#modal-login').classList.remove('hide');
  $('#admin-user').value = '';
  $('#admin-pass').value = '';
  $('#login-err').style.display = 'none';
  if (hintMsg) {
    say(hintMsg);
  }
  setTimeout(() => $('#admin-user').focus(), 150);
}

function closeLoginModal() {
  $('#modal-login').classList.add('hide');
}

if ($('#btn-open-login')) {
  $('#btn-open-login').onclick = () => {
    openLoginModal('Silakan masukkan username dan password admin.');
  };
}

if ($('#btn-cancel-login')) {
  $('#btn-cancel-login').onclick = closeLoginModal;
}

// Lihat / Sembunyikan Password
if ($('#btn-toggle-pass')) {
  $('#btn-toggle-pass').onclick = () => {
    const passInput = $('#admin-pass');
    const isPass = (passInput.type === 'password');
    passInput.type = isPass ? 'text' : 'password';
    $('#btn-toggle-pass').textContent = isPass ? '🙈' : '👁️';
  };
}

// Form Submit Login Admin
if ($('#form-login')) {
  $('#form-login').onsubmit = (e) => {
    e.preventDefault();
    const u = $('#admin-user').value.trim().toLowerCase();
    const p = $('#admin-pass').value.trim();

    // Verifikasi username dan password
    const isMatch = (u === ADMIN_CREDENTIALS.user && (p === ADMIN_CREDENTIALS.pass || p === 'pln123'));

    if (isMatch) {
      try {
        sessionStorage.setItem('vms-admin-auth', 'true');
      } catch (err) {}

      closeLoginModal();
      setRole('admin');
      location.hash = '#dashboard';
      say('Login berhasil. Selamat datang, Administrator PLN.');
    } else {
      $('#login-err').style.display = 'block';
      $('#login-err').textContent = 'Username atau password yang Anda masukkan salah.';
      $('#admin-pass').focus();
      say('Maaf, username atau password yang Anda masukkan salah.');
    }
  };
}

// Tombol Logout Admin
if ($('#btn-logout')) {
  $('#btn-logout').onclick = () => {
    try {
      sessionStorage.removeItem('vms-admin-auth');
    } catch (err) {}

    setRole('user');
    location.hash = '#registrasi';
    say('Admin telah keluar. Mode formulir pendaftaran tamu kembali aktif.');
  };
}

window.addEventListener('hashchange', route);

/* =====================================================================
   3. DASHBOARD MONITORING TAMU
   ===================================================================== */
$('#d1').value = $('#d2').value = ymd();

function renderTable() {
  const today = ymd();
  const from  = $('#d1').value;
  const to    = $('#d2').value;
  const query = $('#q').value.toLowerCase();

  $('#s1').textContent = data.filter((r) => r.tgl === today).length;
  $('#s2').textContent = data.filter((r) => r.inAt === today).length;
  $('#s3').textContent = data.filter((r) => r.outAt === today).length;

  const rows = data.filter((r) => {
    const matchDate  = (!from || r.tgl >= from) && (!to || r.tgl <= to);
    const matchQuery = r.nama.toLowerCase().includes(query);
    return matchDate && matchQuery;
  });

  const getActionBtn = (r) => {
    if (r.status === 'Selesai') return '—';
    const label = r.status === 'Menunggu' ? 'Check In' : 'Check Out';
    return `<button class="btn sm" data-id="${r.id}">${label}</button>`;
  };

  if (rows.length > 0) {
    $('#tb').innerHTML = rows.map((r, i) => `
      <tr>
        <td>${i + 1}</td>
        <td>${r.tgl}</td>
        <td>${esc(r.nama)}</td>
        <td>${esc(r.pegawai)}</td>
        <td>${esc(r.perlu)}</td>
        <td>${r.status}</td>
        <td>${getActionBtn(r)}</td>
      </tr>
    `).join('');
  } else {
    $('#tb').innerHTML = '<tr><td colspan="7" class="e">Tidak ada data tamu.</td></tr>';
  }
}

['d1', 'd2', 'q'].forEach((id) => {
  $('#' + id).oninput = renderTable;
});

$('#tb').onclick = (e) => {
  const id = e.target.dataset.id;
  if (!id) return;

  const r = data.find((x) => x.id == id);
  if (!r) return;

  if (r.status === 'Menunggu') {
    r.status = 'Check In';
    r.inAt   = ymd();
  } else {
    r.status = 'Selesai';
    r.outAt  = ymd();
  }

  store.set('vms-data', data);
  renderTable();

  const msg = (r.status === 'Check In')
    ? `${r.nama} berhasil check in. Silakan masuk.`
    : `${r.nama} sudah check out. Terima kasih atas kunjungannya.`;
  say(msg);
};

$('#xl').onclick = async () => {
  const head = [
    'Tanggal', 'Nama Tamu', 'Perusahaan', 'Pegawai Tujuan',
    'APD', 'Keperluan', 'KTP', 'Kendaraan', 'Name Tag', 'Jumlah', 'Status'
  ];
  const rows = data.map((r) => [
    r.tgl, r.nama, r.usaha, r.pegawai, r.apd,
    r.perlu, r.ktp, r.kend, r.tag, r.jml, r.status
  ]);

  const tsv = [head, ...rows].map((row) => row.join('\t')).join('\n');

  try {
    await navigator.clipboard.writeText(tsv);
    alert('Data berhasil disalin! Buka Excel lalu tempel (Ctrl+V).');
  } catch (err) {
    alert('Gagal menyalin data ke clipboard.');
  }
};

/* =====================================================================
   4. FORMULIR REGISTRASI TAMU
   ===================================================================== */
const FIELDS = ['nama', 'usaha', 'alamat', 'pegawai', 'perlu', 'ktp', 'kend', 'tag', 'jml'];

// Inisialisasi dropdown jumlah tamu (1–99)
$('#jml').innerHTML =
  '<option value="">Pilih jumlah (1–99)</option>' +
  Array.from({ length: 99 }, (_, i) => `<option>${i + 1}</option>`).join('');

$('#f').onsubmit = (e) => {
  e.preventDefault();
  return false;
};

/* ----- Foto Tamu ----- */
function setPhoto(source, srcW, srcH) {
  const W = 168;
  const H = 233;
  const canvas = document.createElement('canvas');
  canvas.width  = W;
  canvas.height = H;

  const scale = Math.max(W / srcW, H / srcH);
  const ctx = canvas.getContext('2d');
  ctx.drawImage(
    source,
    (W - srcW * scale) / 2,
    (H - srcH * scale) / 2,
    srcW * scale,
    srcH * scale
  );

  photo = canvas.toDataURL('image/jpeg', 0.75);
  $('#pv').src = photo;
  $('#pb').textContent = 'Ambil Ulang Foto';

  say('Foto berhasil diambil. Silakan lanjutkan mengisi nama tamu.');
  if (guideIdx === 0) {
    setTimeout(() => goStep(1), 3500);
  }
}

/* Kamera langsung di web */
let camStream = null;

function stopCamera() {
  if (camStream) {
    camStream.getTracks().forEach((t) => t.stop());
  }
  camStream = null;
}

function closeCamera() {
  stopCamera();
  $('#ov').classList.add('hide');
}

async function openCamera() {
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    say('Kamera tidak tersedia di perangkat ini. Silakan pilih foto dari galeri.');
    return $('#pf').click();
  }

  openDialog(
    'Ambil Foto Wajah Tamu',
    '<video id="cam" autoplay playsinline muted style="width:100%;border-radius:10px;background:#000;transform:scaleX(-1)"></video>',
    '<button class="btn ghost" id="cgal">Galeri</button>' +
    '<button class="btn ghost" id="ccan">Batal</button>' +
    '<button class="btn" id="csnap">Ambil Foto</button>'
  );

  say('Hadapkan wajah Anda ke arah kamera dengan jelas, lalu tekan tombol Ambil Foto.');

  $('#ccan').onclick = () => {
    closeCamera();
    say('Foto belum diambil. Anda dapat mencobanya kembali kapan saja.');
  };

  $('#cgal').onclick = () => {
    closeCamera();
    $('#pf').click();
  };

  $('#csnap').onclick = () => {
    const v = $('#cam');
    if (!v.videoWidth) {
      return say('Kamera belum siap, mohon tunggu sebentar.');
    }
    setPhoto(v, v.videoWidth, v.videoHeight);
    closeCamera();
  };

  try {
    camStream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: 'user',
        width:  { ideal: 720 },
        height: { ideal: 960 }
      },
      audio: false
    });
    $('#cam').srcObject = camStream;
  } catch (err) {
    closeCamera();
    say('Kamera tidak dapat diakses. Pastikan izin kamera aktif, atau pilih foto dari berkas galeri.');
    $('#pf').click();
  }
}

$('#pb').onclick = openCamera;

/* Unggah foto berkas galeri */
$('#pf').addEventListener('cancel', () => {
  say('Foto belum dipilih. Anda dapat mencobanya kembali kapan saja.');
});

$('#pf').onchange = (e) => {
  const file = e.target.files[0];
  e.target.value = '';
  if (!file) return;

  if (!file.type.startsWith('image/')) {
    return say('Berkas yang dipilih bukan gambar. Mohon pilih foto.');
  }

  const url = URL.createObjectURL(file);
  const img = new Image();
  img.onerror = () => say('Foto gagal dimuat. Mohon pilih foto lain.');
  img.onload  = () => {
    setPhoto(img, img.width, img.height);
    URL.revokeObjectURL(url);
  };
  img.src = url;
};

/* ----- APD (Alat Pelindung Diri) ----- */
const apdBoxes = $$('#apd input[value]');

function onApdDone() {
  say('APD lengkap, sangat bagus! Terima kasih telah mengutamakan keselamatan kerja.');
  if (guideIdx === 5) {
    setTimeout(() => goStep(6), 3500);
  }
}

function onApdChange() {
  const checked = apdBoxes.filter((b) => b.checked).length;
  const missing = apdBoxes.filter((b) => !b.checked).map((b) => b.value);

  $('#apdall').checked = (checked === APD_LIST.length);
  if (checked > 0) {
    $('#apdnone').checked = false;
  }

  if (checked === APD_LIST.length) {
    return onApdDone();
  }

  if (checked > 0) {
    say(`Anda baru memakai ${checked} dari 3 APD. ${missing.join(' dan ')} belum dicentang. Demi keselamatan, silakan lengkapi di pos keamanan.`);
  }
}

apdBoxes.forEach((b) => b.addEventListener('change', onApdChange));

$('#apdall').addEventListener('change', (e) => {
  apdBoxes.forEach((b) => b.checked = e.target.checked);
  if (e.target.checked) {
    $('#apdnone').checked = false;
    onApdDone();
  }
});

$('#apdnone').addEventListener('change', (e) => {
  if (!e.target.checked) return;
  apdBoxes.forEach((b) => b.checked = false);
  $('#apdall').checked = false;
  say('Anda tidak memakai APD. Demi keselamatan kerja, silakan ambil dan kenakan APD di pos petugas keamanan.');
  if (guideIdx === 5) {
    setTimeout(() => goStep(6), 7000);
  }
});

/* ----- Validasi KTP / Identitas ----- */
function ktpError() {
  const v = $('#ktp').value.trim();
  if (!v) return '';

  if (/^\d+$/.test(v)) {
    if (v.length === 12) return ''; // Dianggap nomor SIM
    if (v.length === 16) {
      const prov = +v.slice(0, 2);
      return (prov < 11 || prov > 94)
        ? `Dua digit awal (${v.slice(0, 2)}) bukan kode provinsi yang valid. Periksa kembali nomor KTP Anda.`
        : '';
    }
    const n = v.length;
    return (n < 16)
      ? `Nomor KTP kurang ${16 - n} digit. KTP wajib 16 digit angka.`
      : `Nomor KTP kelebihan ${n - 16} digit. KTP wajib 16 digit angka.`;
  }

  return /^[A-Za-z0-9]{6,20}$/.test(v)
    ? ''
    : 'Nomor identitas salah. KTP harus 16 digit angka, atau paspor tanpa spasi dan simbol.';
}

let ktpTimer;
let lastKtpMsg = '';

function ktpAnnounce() {
  const v   = $('#ktp').value.trim();
  const err = ktpError();

  $('#ktp-e').textContent = err;
  $('#ktp-e').className   = 'err';
  $('#ktp').classList.toggle('bad', !!err);

  let msg = err;
  if (!msg && /^\d{12}$/.test(v)) {
    msg = 'Nomor 12 digit ini dianggap nomor SIM. Jika menggunakan KTP, nomor harus 16 digit.';
  }

  if (msg && msg !== lastKtpMsg) {
    lastKtpMsg = msg;
    say(msg);
  }
  if (!msg) {
    lastKtpMsg = '';
  }
}

$('#ktp').addEventListener('input', () => {
  const v   = $('#ktp').value.trim();
  const err = ktpError();
  const box = $('#ktp-e');
  const partial = /^\d+$/.test(v) && v.length < 16;

  box.textContent = partial ? `${v.length}/16 digit` : err;
  box.className   = partial ? 'err hint' : 'err';
  $('#ktp').classList.toggle('bad', !!err && !partial);

  clearTimeout(ktpTimer);
  ktpTimer = setTimeout(ktpAnnounce, 1800);
});

$('#ktp').addEventListener('change', () => {
  clearTimeout(ktpTimer);
  ktpAnnounce();
});

/* ----- Tombol Kirim & Konfirmasi Registrasi ----- */
$('#sub').onclick = () => {
  const apd   = apdBoxes.filter((b) => b.checked).map((b) => b.value);
  const noApd = $('#apdnone').checked;

  const empty = FIELDS.find((id) => !$('#' + id).value.trim());
  if (empty) {
    const labelText = $(`label[for=${empty}]`).textContent.replace('*', '').trim();
    say(`Mohon lengkapi kolom ${labelText} terlebih dahulu.`);
    return $('#' + empty).focus();
  }

  const ktpErr = ktpError();
  if (ktpErr) {
    say(ktpErr);
    return $('#ktp').focus();
  }

  if (!apd.length && !noApd) {
    say('Mohon pilih APD yang Anda kenakan, atau centang Tidak memakai APD.');
    return $('#apdl').scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  const agree = $('#agree-induction');
  if (agree && !agree.checked) {
    if ($('#agree-e')) $('#agree-e').style.display = 'block';
    say('Mohon baca dan centang persetujuan Safety and Security Induction terlebih dahulu.');
    agree.scrollIntoView({ behavior: 'smooth', block: 'center' });
    agree.focus();
    return;
  }

  showConfirm(apd, noApd, () => {
    const rec = {
      id:     Date.now(),
      tgl:    ymd(),
      apd:    noApd ? 'Tidak memakai APD' : apd.join(', '),
      foto:   photo,
      status: 'Menunggu'
    };

    FIELDS.forEach((id) => {
      rec[id] = $('#' + id).value.trim();
    });

    data.unshift(rec);
    store.set('vms-data', data);

    $('#f').reset();
    photo = '';
    $('#pv').src = PHOTO_PLACEHOLDER;
    $('#pb').textContent = 'Ambil Foto';
    $('#ktp-e').textContent = '';
    $('#ktp').classList.remove('bad');
    if ($('#agree-induction')) $('#agree-induction').checked = false;
    if ($('#agree-e')) $('#agree-e').style.display = 'none';

    const lacking = APD_LIST.filter((x) => !apd.includes(x));
    const apdNote = lacking.length
      ? ` APD yang belum Anda kenakan: ${lacking.join(', ')}. Harap ambil di petugas keamanan.`
      : '';

    say(`Registrasi berhasil. Terima kasih, ${rec.nama}. Silakan menuju petugas keamanan untuk mengambil kartu name tag.${apdNote}`);
    showDone(rec.nama);
  });
};

