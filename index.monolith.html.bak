/* ----- Fitur Drag-and-Drop Robot (Sentuhan & Mouse) ----- */
(function enableDrag() {
  const bot = $('#bot');
  const fab = $('#fab');

  let startX  = 0;
  let startY  = 0;
  let originX = 0;
  let originY = 0;
  let moved   = false;
  let down    = false;

  fab.title = 'Geser untuk memindahkan posisi asisten';

  function place(x, y) {
    const w = bot.offsetWidth;
    const h = bot.offsetHeight;
    x = Math.max(0, Math.min(innerWidth - w, x));
    y = Math.max(0, Math.min(innerHeight - h, y));

    Object.assign(bot.style, {
      left:   x + 'px',
      top:    y + 'px',
      right:  'auto',
      bottom: 'auto'
    });

    bot.classList.toggle('left', x + w / 2 < innerWidth / 2);
    bot.classList.toggle('top',  y < 290);
  }

  function end() {
    if (!down) return;
    down = false;
    bot.classList.remove('drag');

    if (moved) {
      wasDragged = true;
      setTimeout(() => { wasDragged = false; }, 60);
      store.set('vms-pos', {
        x: parseFloat(bot.style.left),
        y: parseFloat(bot.style.top)
      });
    }
  }

  fab.addEventListener('pointerdown', (e) => {
    down    = true;
    moved   = false;
    startX  = e.clientX;
    startY  = e.clientY;

    const r = bot.getBoundingClientRect();
    originX = r.left;
    originY = r.top;

    try {
      fab.setPointerCapture(e.pointerId);
    } catch (x) {}
  });

  fab.addEventListener('pointermove', (e) => {
    if (!down) return;

    const dx = e.clientX - startX;
    const dy = e.clientY - startY;

    if (!moved && Math.hypot(dx, dy) < 6) return;
    moved = true;
    bot.classList.add('drag');

    place(originX + dx, originY + dy);
  });

  fab.addEventListener('pointerup', end);
  fab.addEventListener('pointercancel', end);

  // Mengembalikan posisi tersimpan dari local storage
  const saved = store.get('vms-pos', null);
  if (saved && isFinite(saved.x) && isFinite(saved.y)) {
    place(saved.x, saved.y);
  }

  window.addEventListener('resize', () => {
    if (bot.style.left) {
      place(parseFloat(bot.style.left), parseFloat(bot.style.top));
    }
  });
})();

/* =====================================================================
   6. MODEL 3D THREE.JS — "VOLTI", PETUGAS K3LH PLN
   APD Standar K3LH:
     - Safety helmet kuning dengan lampu sorot & logo petir PLN
     - Kacamata safety transparan
     - Earmuff pelindung telinga
     - Pakaian kerja wearpack biru khas PLN
     - Rompi reflektif oranye bergaris perak & emblem PLN
     - Sarung tangan safety (tangan kanan melambai menyapa)
     - Sepatu safety dengan toe-cap baja
   ===================================================================== */
let renderer, scene, camera, rig, robot;

function createRobot(T) {
  const mat = (color, opt = {}) => new T.MeshStandardMaterial({
    color,
    roughness: 0.35,
    metalness: 0.1,
    ...opt
  });

  const C = {
    white:  mat(0xf4f7f9),
    blue:   mat(0x0a8fd8, { roughness: 0.5 }),
    yellow: mat(0xffe600),
    ridge:  mat(0xd9be00),
    orange: mat(0xff7a00, { roughness: 0.6, side: T.DoubleSide }),
    red:    mat(0xe2231a),
    glove:  mat(0xffb300, { roughness: 0.7 }),
    boot:   mat(0x1a1a1a, { roughness: 0.6 }),
    visor:  mat(0x0b1b33, { roughness: 0.12, metalness: 0.4 }),
    metal:  mat(0xb8c2c8, { metalness: 0.5 }),
    strip:  mat(0xe8eef2, { metalness: 0.7, roughness: 0.2 }),
    glass:  mat(0x9fe8ff, { transparent: true, opacity: 0.25, roughness: 0.05, metalness: 0.2 }),
    glow:   mat(0x22e6ff, { emissive: 0x22e6ff, emissiveIntensity: 1 }),
    lamp:   mat(0xfff3b0, { emissive: 0xffd400, emissiveIntensity: 1 })
  };

  const ball = (r, m, [sx, sy, sz], [x, y, z], parent) => {
    const o = new T.Mesh(new T.SphereGeometry(r, 32, 20), m);
    o.scale.set(sx, sy, sz);
    o.position.set(x, y, z);
    parent.add(o);
    return o;
  };

  const cyl = (rt, rb, h, m, [x, y, z], parent, open = false) => {
    const o = new T.Mesh(new T.CylinderGeometry(rt, rb, h, 40, 1, open), m);
    o.position.set(x, y, z);
    parent.add(o);
    return o;
  };

  // Simbol petir khas PLN
  const bolt = (m, k = 1) => {
    const shape = new T.Shape();
    [
      [0.05, 0.2], [-0.12, -0.03], [-0.01, -0.03],
      [-0.06, -0.22], [0.12, 0.04], [0.01, 0.04]
    ].forEach(([x, y], i) => {
      if (i === 0) shape.moveTo(x * k, y * k);
      else shape.lineTo(x * k, y * k);
    });
    return new T.Mesh(new T.ShapeGeometry(shape), m);
  };

  const g = new T.Group();

  /* --- Kepala & Wajah --- */
  const head = new T.Group();
  head.position.y = 0.9;
  g.add(head);

  ball(1, C.white, [1.2, 0.95, 1], [0, 0, 0], head);
  ball(0.8, C.visor, [1.2, 0.78, 0.4], [0, 0, 0.8], head);
  ball(0.8, C.glass, [1.26, 0.5, 0.43], [0, 0.06, 0.8], head); // Kacamata safety

  // Earmuff pelindung telinga
  [-1, 1].forEach((k) => {
    const ear = cyl(0.3, 0.3, 0.22, C.orange, [k * 1.28, 0, 0], head);
    ear.rotation.z = Math.PI / 2;
  });

  // Mata LED
  const eyes = new T.Group();
  eyes.position.y = 0.12;
  head.add(eyes);
  [-0.3, 0.3].forEach((x) => {
    ball(0.1, C.glow, [1, 1.5, 0.4], [x, 0, 1.12], eyes);
  });

  // Senyum LED & Mulut berbicara
  const smile = new T.Mesh(new T.TorusGeometry(0.17, 0.03, 8, 24, Math.PI), C.glow);
  smile.rotation.z = Math.PI;
  smile.position.set(0, -0.02, 1.12);
  head.add(smile);

  const mouth = ball(0.12, C.glow, [1.6, 0.2, 0.3], [0, -0.22, 1.12], head);
  mouth.visible = false;

  /* --- Safety Helmet Kuning K3 --- */
  const dome = new T.Mesh(
    new T.SphereGeometry(1, 40, 20, 0, Math.PI * 2, 0, Math.PI / 2),
    C.yellow
  );
  dome.scale.set(1.25, 0.85, 1.12);
  dome.position.y = 0.38;
  head.add(dome);

  const brim = new T.Mesh(
    new T.CylinderGeometry(1.3, 1.3, 0.07, 40, 1, false, -Math.PI * 0.55, Math.PI * 1.1),
    C.yellow
  );
  brim.scale.z = 1.15;
  brim.position.y = 0.4;
  head.add(brim);

  const ridge = new T.Mesh(new T.TorusGeometry(1, 0.05, 8, 40, Math.PI), C.ridge);
  ridge.rotation.y = Math.PI / 2;
  ridge.scale.set(1.13, 0.87, 1);
  ridge.position.y = 0.38;
  head.add(ridge);

  // Logo PLN di helm
  const badgeTex = new T.TextureLoader().load('img/pln-logo.png');
  const badgeMat = new T.MeshStandardMaterial({
    map: badgeTex,
    transparent: true,
    roughness: 0.3,
    metalness: 0.1
  });
  const badge = new T.Mesh(new T.PlaneGeometry(0.32, 0.44), badgeMat);
  badge.position.set(0, 0.78, 1.01);
  badge.rotation.x = -0.5;
  head.add(badge);

  const tip = ball(0.09, C.lamp, [1, 1, 1], [0, 1.02, 0.74], head); // Lampu senter helm

  /* --- Badan: Wearpack Biru & Rompi Reflektif Oranye --- */
  ball(1, C.blue, [0.75, 0.8, 0.62], [0, -0.75, 0], g);

  const vest = new T.Mesh(
    new T.SphereGeometry(1, 32, 16, 0, Math.PI * 2, Math.PI * 0.28, Math.PI * 0.46),
    C.orange
  );
  vest.scale.set(0.77, 0.82, 0.64);
  vest.position.y = -0.75;
  g.add(vest);

  // Strip reflektif perak pada rompi
  [[-0.72, 0.775, 0.645], [-0.98, 0.745, 0.62]].forEach(([y, sx, sz]) => {
    const s = cyl(1, 1, 0.07, C.strip, [0, y, 0], g, true);
    s.scale.set(sx, 1, sz);
  });

  // Emblem PLN di dada rompi
  const emblem = new T.Group();
  emblem.position.set(0, -0.45, 0.6);
  emblem.rotation.x = -0.1;
  g.add(emblem);

  const disc = cyl(0.24, 0.24, 0.05, C.yellow, [0, 0, 0], emblem);
  disc.rotation.x = Math.PI / 2;

  const emblemBolt = bolt(C.red, 0.95);
  emblemBolt.position.z = 0.03;
  emblem.add(emblemBolt);

  /* --- Lengan & Sarung Tangan K3 (Tangan Kanan Melambai) --- */
  const makeArm = (side) => {
    const a = new T.Group();
    a.position.set(side * 0.8, -0.55, 0);

    ball(0.15, C.blue,  [1, 1, 1],   [0, 0, 0], a);
    ball(0.13, C.blue,  [1, 2.6, 1], [0, -0.3, 0], a);
    ball(0.17, C.glove, [1, 1, 0.9], [0, -0.68, 0], a);
    ball(0.065, C.glove, [1, 1, 1],  [side * 0.13, -0.62, 0.05], a);

    g.add(a);
    return a;
  };

  makeArm(-1).rotation.z = -0.3;
  const arm = makeArm(1);
  arm.rotation.z = 0.3;

  /* --- Kaki: Celana Wearpack & Sepatu Safety --- */
  [-0.28, 0.28].forEach((x) => {
    cyl(0.15, 0.14, 0.5, C.blue, [x, -1.65, 0], g);
    cyl(0.16, 0.16, 0.06, C.strip, [x, -1.88, 0], g);
    ball(0.24, C.boot, [1, 0.7, 1.55], [x, -2.0, 0.12], g);
    ball(0.18, C.metal, [1, 0.65, 1],  [x, -1.99, 0.42], g); // Ujung pelindung baja
  });

  // Bayangan di lantai
  const shadow = new T.Mesh(
    new T.CircleGeometry(0.9, 40),
    new T.MeshBasicMaterial({ color: 0x000000, transparent: true, opacity: 0.18 })
  );
  shadow.rotation.x = -Math.PI / 2;
  shadow.position.y = -2.17;
  g.add(shadow);

  return { g, head, eyes, mouth, smile, arm, tip };
}

function initRobot() {
  try {
    renderer = new THREE.WebGLRenderer({
      canvas: $('#fabc'),
      alpha: true,
      antialias: true
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(260, 380, false);

    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(35, 260 / 380, 0.1, 50);
    camera.position.set(0, 0, 8);

    scene.add(new THREE.AmbientLight(0xffffff, 0.75));

    const sun = new THREE.DirectionalLight(0xffffff, 0.8);
    sun.position.set(2, 3, 4);
    scene.add(sun);

    rig = new THREE.Group();
    scene.add(rig);

    robot = createRobot(THREE);
    rig.add(robot.g);

    requestAnimationFrame(animate);
  } catch (err) {
    $('#fab').insertAdjacentHTML('afterbegin', '<div style="font-size:70px">🤖</div>');
  }
}

function animate(ms) {
  requestAnimationFrame(animate);
  const t = ms / 1000;
  const R = robot;
  if (!R) return;

  // Gerakan menoleh halus & bernapas
  R.head.rotation.y = Math.sin(t * 0.8) * 0.25;
  R.head.rotation.x = Math.sin(t * 0.6) * 0.05;
  R.head.position.y = 0.9 + Math.sin(t * 1.6) * 0.03;

  // Gerakan artikulasi mulut saat berbicara
  const talk = speaking ? 0.25 + Math.abs(Math.sin(t * 14)) * 0.85 : 0.2;
  R.mouth.scale.y += (talk - R.mouth.scale.y) * 0.4;
  R.mouth.visible = speaking;
  R.smile.visible = !speaking;

  // Gerakan melambaikan tangan kanan
  const wave = speaking || ms < waveUntil;
  const targetArmZ = wave ? (2.5 + Math.sin(t * 8) * 0.3) : 0.3;
  R.arm.rotation.z += (targetArmZ - R.arm.rotation.z) * 0.15;

  // Kedipan mata periodik
  const isBlinking = (Math.sin(t * 1.3) > 0.985 || (t % 4) > 3.9);
  R.eyes.scale.y = isBlinking ? 0.1 : 1;

  // Efek kedip lampu senter di atas helm
  R.tip.material.emissiveIntensity = 0.6 + Math.sin(t * 4) * 0.4;

  renderer.render(scene, camera);
}

/* =====================================================================
   7. INISIALISASI APLIKASI
   ===================================================================== */
if ('speechSynthesis' in window) {
  speechSynthesis.onvoiceschanged = loadVoices;
  loadVoices();
}

initRobot();
setRole(role);
</script>
</body>
</html>
