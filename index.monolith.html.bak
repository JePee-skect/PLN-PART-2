/* ----- State Asisten ----- */
let guideIdx       = -1;
let lastHint       = '';
let quiet          = false;
let voiceOn        = true;
let speaking       = false;
let waveUntil      = 0;
let audioUnlocked  = !!(navigator.userActivation && navigator.userActivation.hasBeenActive);
let pendingSpeech  = null;
let lastActivity   = Date.now();
let idleNotified   = false;
let bubbleTimer;
const greeted      = {};
const msgBox       = $('#msgs');

/* ----- Manajemen Pesan & Sapaan ----- */
function addMsg(text, cls) {
  const d = document.createElement('div');
  d.className   = 'm ' + cls;
  d.textContent = text;
  msgBox.appendChild(d);
  msgBox.scrollTop = 1e9;
}

function say(text) {
  waveUntil = performance.now() + 2600;
  addMsg(text, 'b');
  speak(text);
  showBubble(text);
}

function showBubble(text) {
  if (!$('#panel').classList.contains('hide')) return;
  const b = $('#bub');
  b.textContent = text;
  b.classList.remove('hide');
  clearTimeout(bubbleTimer);
  bubbleTimer = setTimeout(() => {
    b.classList.add('hide');
  }, Math.max(5000, text.length * 75));
}

function botHello(page) {
  const key = page + role;
  if (greeted[key]) return;
  greeted[key] = true;

  if (page === 'registrasi') {
    say('Selamat datang di PLN. Saya asisten virtual siap memandu Anda. Tekan Mulai panduan untuk bimbingan pengisian formulir langkah demi langkah.');
  } else {
    say('Halo admin! Anda dapat memantau data tamu, melakukan check in dan check out, serta menyalin laporan ke Excel.');
  }
}

/* ----- Suara (Text-to-Speech) — Karakter Pria Tegas, Berwibawa & Natural ----- */
let voices = [];
let speakTimer = null;
let currentUtterance = null;
let noVoiceWarned = false;
let userVoiceIndex = store.get('vms-voice-idx', -1);
let userVoiceRate  = parseFloat(store.get('vms-voice-rate', 1.0)) || 1.0;

/* Mode Suara: 'browser' atau 'elevenlabs' (suara kloning sendiri) */
let voiceMode     = store.get('vms-voice-mode', 'browser');
let elevenApiKey  = store.get('vms-el-key', '');
let elevenVoiceId = store.get('vms-el-vid', '');
const audioCache  = new Map();
let currentAudioPlayer = null;

function loadVoices() {
  try {
    voices = speechSynthesis.getVoices();
    populateVoiceSelect();
  } catch (e) {}
}

/**
 * Normalisasi teks untuk artikulasi pengucapan agar terdengar manusiawi & fasih:
 * - Menghilangkan singkatan kaku (PLN -> P L N, K3LH -> K 3 L H, APD -> A P D)
 * - Menyesuaikan angka dan istilah teknis
 * - Menambahkan jeda napas tanda baca
 */
function cleanSpeechText(text) {
  if (!text) return '';
  return text
    .replace(/\bPLN\b/g, 'P L N')
    .replace(/\bPUSHARLIS\b/gi, 'Pusharlis')
    .replace(/\bUP2WVI\b/gi, 'U P 2 W enam')
    .replace(/\bK3LH\b/gi, 'K 3 L H')
    .replace(/\bK3\b/gi, 'K 3')
    .replace(/\bAPD\b/g, 'A P D')
    .replace(/\bKTP\b/g, 'K T P')
    .replace(/\bSIM\b/g, 'S I M')
    .replace(/\bNIK\b/g, 'N I K')
    .replace(/\bNo\.Pol\b/gi, 'Nomor Polisi')
    .replace(/\bNo\.\s*/gi, 'Nomor ')
    .replace(/Ctrl\s*V/gi, 'Control V')
    .replace(/16\s*digit/gi, 'enam belas digit')
    .replace(/12\s*digit/gi, 'dua belas digit')
    .replace(/1–99/g, 'satu sampai sembilan puluh sembilan')
    .replace(/([.!?])\s*/g, '$1 ')
    .replace(/\s+/g, ' ')
    .trim();
}

/**
 * Memilih suara pria bahasa Indonesia yang paling natural & berwibawa:
 * 1. Pilihan pengguna yang disimpan manual di dropdown
 * 2. Microsoft Ardi Online (Natural) - Indonesian (Indonesia) -> Suara Pria Studio AI di Edge
 * 3. Suara pria ID lainnya (Andika, atau yang mengandung kata kunci male/pria/ardi)
 * 4. Suara Natural ID non-wanita
 * 5. Suara ID pertama di browser
 */
function pickVoice() {
  if (userVoiceIndex >= 0 && voices[userVoiceIndex]) {
    return voices[userVoiceIndex];
  }

  const isFemaleName = (name = '') => /gadis|female|wanita|perempuan|cewek|siti|yasmin|zira/i.test(name);
  const idVoices = voices.filter(v => /^id([-_]|$)/i.test(v.lang));

  // 1. Suara pria Indonesia Neural (Edge Microsoft Ardi) — KUALITAS STUDIO TERTINGGI
  const ardi = idVoices.find(v => /ardi/i.test(v.name));
  if (ardi) return ardi;

  // 2. Suara pria Indonesia lain
  const otherMale = idVoices.find(v => /male|pria|laki|andika/i.test(v.name) && !isFemaleName(v.name));
  if (otherMale) return otherMale;

  // 3. Suara natural / online ID yang bukan wanita
  const naturalMale = idVoices.find(v => /natural|online/i.test(v.name) && !isFemaleName(v.name));
  if (naturalMale) return naturalMale;

  // 4. Suara ID apapun yang tidak dinamai wanita
  const anyNonFemale = idVoices.find(v => !isFemaleName(v.name));
  if (anyNonFemale) return anyNonFemale;

  // 5. Suara ID pertama yang ada di browser
  if (idVoices.length > 0) return idVoices[0];

  // 6. Cadangan serumpun bahasa Melayu
  const msVoice = voices.find(v => /^ms([-_]|$)/i.test(v.lang) && !isFemaleName(v.name));
  if (msVoice) return msVoice;

  return null;
}

function populateVoiceSelect() {
  const sel = $('#voice-select');
  if (!sel || !voices.length) return;

  const currentVoice = pickVoice();
  sel.innerHTML = voices.map((v, i) => {
    let label = v.name;
    const isId = /^id([-_]|$)/i.test(v.lang);
    const isArdi = /ardi/i.test(v.name);
    const isNatural = /natural|online/i.test(v.name);

    if (isArdi) label = `⭐ ${v.name} (Pria Natural - Terbaik)`;
    else if (isId && isNatural) label = `✨ ${v.name} (Indonesia Natural)`;
    else if (isId) label = `🇮🇩 ${v.name}`;

    return `<option value="${i}">${label}</option>`;
  }).join('');

  if (currentVoice) {
    const idx = voices.indexOf(currentVoice);
    if (idx >= 0) sel.value = idx;
  }

  // Perbarui banner tips browser
  const hasArdi = voices.some(v => /ardi/i.test(v.name));
  const tipEl = $('#voice-tip');
  if (tipEl) {
    if (hasArdi) {
      tipEl.innerHTML = '✅ <b>Suara Microsoft Ardi (Natural) aktif!</b> Ini adalah suara pria AI paling jernih & mirip manusia asli.';
      tipEl.style.background = 'rgba(46, 204, 113, 0.15)';
      tipEl.style.color = 'var(--text)';
    } else {
      tipEl.innerHTML = '💡 <b>Tips:</b> Buka sistem ini di browser <b>Microsoft Edge</b> untuk mengaktifkan suara pria <b>Microsoft Ardi (Natural)</b> yang sangat fasih dan mirip manusia asli.';
      tipEl.style.background = 'rgba(27, 99, 120, 0.1)';
      tipEl.style.color = 'var(--muted)';
    }
  }
}

/* =====================================================================
   SINTESIS SUARA ELEVENLABS (VOICE CLONING SUARA SENDIRI)
   ===================================================================== */
async function speakWithElevenLabs(text) {
  const clean = cleanSpeechText(text);
  if (!clean || !elevenApiKey || !elevenVoiceId) return false;

  // Cek cache audio agar hemat kuota ElevenLabs
  if (audioCache.has(clean)) {
    playCachedAudio(audioCache.get(clean));
    return true;
  }

  try {
    const res = await fetch(`https://api.elevenlabs.io/v1/text-to-speech/${elevenVoiceId}`, {
      method: 'POST',
      headers: {
        'xi-api-key': elevenApiKey,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        text: clean,
        model_id: 'eleven_multilingual_v2',
        voice_settings: {
          stability: 0.5,
          similarity_boost: 0.85
        }
      })
    });

    if (!res.ok) {
      console.warn('ElevenLabs API error, fallback to browser TTS:', res.status);
      return false;
    }

    const blob = await res.blob();
    const url  = URL.createObjectURL(blob);
    audioCache.set(clean, url);
    playCachedAudio(url);
    return true;
  } catch (err) {
    console.warn('Gagal memanggil ElevenLabs:', err);
    return false;
  }
}

function playCachedAudio(url) {
  if (currentAudioPlayer) {
    currentAudioPlayer.pause();
    currentAudioPlayer = null;
  }

  const audio = new Audio(url);
  currentAudioPlayer = audio;

  audio.onplay  = () => { speaking = true; };
  audio.onended = () => { speaking = false; };
  audio.onerror = () => { speaking = false; };

  audio.play().catch(() => { speaking = false; });
}

/* =====================================================================
   SINTESIS SUARA BROWSER (NATIVE TTS / ARDI)
   ===================================================================== */
function speakWithBrowser(text) {
  try {
    if (!voices.length) loadVoices();
    const voice = pickVoice();

    speechSynthesis.cancel();
    speechSynthesis.resume();

    const spokenText = cleanSpeechText(text);
    const u = new SpeechSynthesisUtterance(spokenText);

    if (voice) {
      u.voice = voice;
      u.lang  = voice.lang;
    } else {
      u.lang = 'id-ID';
    }

    const isNeural = voice && /natural|online|neural|ardi/i.test(voice.name);
    const isFemale = voice && /gadis|female|wanita|google/i.test(voice.name);

    if (isNeural) {
      u.pitch = 1.0;
      u.rate  = userVoiceRate;
    } else if (isFemale) {
      u.pitch = 0.88;
      u.rate  = userVoiceRate * 0.96;
    } else {
      u.pitch = 1.0;
      u.rate  = userVoiceRate;
    }

    u.volume = 1.0;

    u.onstart = () => { speaking = true; };
    u.onend   = () => { speaking = false; };
    u.onerror = (e) => {
      speaking = false;
      if (e.error === 'not-allowed') {
        audioUnlocked = false;
        pendingSpeech = text;
      }
    };

    currentUtterance = u;
    clearTimeout(speakTimer);
    speakTimer = setTimeout(() => {
      speechSynthesis.speak(u);
    }, 60);
  } catch (e) {}
}

/* Fungsi Utama Speak */
function speak(text) {
  if (!voiceOn) return;
  if (!audioUnlocked) {
    pendingSpeech = text;
    return;
  }

  // Jika mode ElevenLabs aktif dan kredensial terisi
  if (voiceMode === 'elevenlabs' && elevenApiKey && elevenVoiceId) {
    if ('speechSynthesis' in window) speechSynthesis.cancel();
    speakWithElevenLabs(text).then((success) => {
      if (!success) {
        speakWithBrowser(text);
      }
    });
    return;
  }

  // Mode standar browser TTS
  speakWithBrowser(text);
}

